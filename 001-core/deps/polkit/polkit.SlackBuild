#!/bin/bash

# Load helpers
source "$BUILDERUTILSPATH/latestfromgithub.sh"
source "$BUILDERUTILSPATH/gobo_splitter.sh"

PRGNAM=Polkit
CWD=$(dirname "$0")
TMP="$MODULEPATH/$PRGNAM"
DEST="$TMP/package-$PRGNAM"

set -e

[ -e "$TMP" ] && rm -rf "$TMP"
mkdir -p "$TMP"
cd "$TMP"

# 1. FETCH VERSION & SOURCE
info=$(DownloadLatestFromGithub "polkit-org" "polkit")
VERSION=${info#* }

tar xf polkit-$VERSION.tar.?z*
cd polkit-$VERSION

# 2. PATH DEFINITIONS
PKG_DIR="/Programs/$PRGNAM/$VERSION"

# 3. PATCHING
[ -f "$CWD/dont-set-wheel-group-as-admin.patch" ] && patch -p0 < "$CWD/dont-set-wheel-group-as-admin.patch"

# 4. CONFIGURE (Meson)
# Perhatikan: --libdir dsb di Meson bersifat relatif terhadap prefix jika tidak diawali '/'
mkdir build && cd build
CFLAGS="$GCCFLAGS" \
meson setup .. \
	--prefix="$PKG_DIR" \
	--libdir="Lib" \
	--libexecdir="Libexec" \
	--bindir="bin" \
	--sbindir="bin" \
	--includedir="include" \
	--datadir="Shared" \
	--sysconfdir="/System/Settings" \
	--localstatedir="/System/Variable" \
	--buildtype=release \
	-Dintrospection=true \
	-Dsession_tracking=elogind \
	-Dsystemdsystemunitdir="Lib/systemd/system" \
	-Dauthfw=pam \
	-Dpam_module_dir="/System/Index/Lib/security" \
	-Dpam_prefix="/System/Settings/pam.d" \
	-Dexamples=false \
	-Dgtk_doc=false \
	-Dman=false \
	-Dtests=false

# 5. BUILD & INSTALL
DESTDIR="$DEST" ninja -j${NUMBERTHREADS} install

# 6. GOBOLINUX INTEGRATION & FIXES

# A. Meson terkadang tetap membuat folder 'etc' dan 'var' di dalam prefix 
# jika sysconfdir/localstatedir tidak diproses secara absolut oleh skrip instalasi paket.
if [ -d "$DEST$PKG_DIR/etc" ]; then
    mkdir -p "$DEST/System/Settings"
    cp -a "$DEST$PKG_DIR/etc/"* "$DEST/System/Settings/"
    rm -rf "$DEST$PKG_DIR/etc"
fi

if [ -d "$DEST$PKG_DIR/var" ]; then
    mkdir -p "$DEST/System/Variable"
    cp -a "$DEST$PKG_DIR/var/"* "$DEST/System/Variable/"
    rm -rf "$DEST$PKG_DIR/var"
fi

# B. Polkit butuh user/group khusus. Biasanya diatur saat instalasi OS, 
# tapi kita pastikan folder perizinannya benar.
chmod 700 "$DEST/System/Settings/polkit-1/rules.d" 2>/dev/null || true
chmod 700 "$DEST/System/Variable/lib/polkit-1" 2>/dev/null || true

# 7. CALL GENERIC SPLITTER
# Polkit menyertakan libpolkit-gobject dan libpolkit-agent.
# Header dan file .pc akan masuk ke 05-devel.
GoboSplitter "$PRGNAM" "$VERSION" "$DEST"

# 8. CLEANUP
rm -rf "$TMP"

echo "========================================================"
echo "Build $PRGNAM-$VERSION selesai."
echo "Konfigurasi sistem dipindahkan ke /System/Settings"
echo "========================================================"
