#!/bin/bash

source "$BUILDERUTILSPATH/latestfromgithub.sh"

PRGNAM=Polkit
CWD=$(dirname "$0")
TMP="$MODULEPATH/$PRGNAM"

set -e

[ -e "$TMP" ] && rm -rf "$TMP"
mkdir -p "$TMP"
cd "$TMP"

# Ambil versi terbaru dari GitHub polkit-org
info=$(DownloadLatestFromGithub "polkit-org" "polkit")
VERSION=${info#* }

# Path standar GoboLinux
PKG_DIR="/Programs/$PRGNAM/$VERSION"
DEST="$TMP/package-$PRGNAM"
WORK_AREA="$MODULEPATH/work_area/$PRGNAM"

tar xf polkit-$VERSION.tar.?z*
cd polkit-$VERSION

# Terapkan patch Porteux jika masih relevan
[ -f "$CWD/dont-set-wheel-group-as-admin.patch" ] && patch -p0 < "$CWD/dont-set-wheel-group-as-admin.patch"

mkdir build && cd build
CFLAGS="$GCCFLAGS" \
meson setup .. \
	--prefix="$PKG_DIR" \
	--libdir="Lib" \
	--libexecdir="Libexec" \
	--bindir="bin" \
	--sbindir="bin" \
	--includedir="include" \
	--datadir="Shared" \
	--sysconfdir="/System/Settings" \
	--localstatedir="/System/Variable" \
	--buildtype=release \
	-Dintrospection=true \
	-Dsession_tracking=elogind \
	-Dsystemdsystemunitdir="Lib/systemd/user" \
	-Dauthfw=pam \
	-Dpam_module_dir="/System/Index/Lib/security" \
	-Dpam_prefix="/System/Settings/pam.d" \
	-Dexamples=false \
	-Dgtk_doc=false \
	-Dman=false \
	-Dtests=false

DESTDIR="$DEST" ninja -j${NUMBERTHREADS} install

# --- TAHAP INTEGRASI GOBO ---

# Polkit membutuhkan direktori spesifik di /System/Settings untuk policy
# Kita pastikan struktur di dalam DEST mencerminkan ini
mkdir -p "$DEST/System/Settings/polkit-1"

# Pindahkan file dari prefix/etc jika meson tidak menghormati sysconfdir secara penuh
if [ -d "$DEST$PKG_DIR/etc" ]; then
    cp -a "$DEST$PKG_DIR/etc/"* "$DEST/System/Settings/"
    rm -rf "$DEST$PKG_DIR/etc"
fi

# Pastikan folder target di work_area bersih
rm -rf "$WORK_AREA"
mkdir -p "$WORK_AREA"

# Salin ke work_area
# Struktur: $WORK_AREA/Programs/Polkit/$VERSION dan $WORK_AREA/System/Settings
cp -a "$DEST"/* "$WORK_AREA/"

echo ""
echo "========================================================"
echo "Selesai: $PRGNAM versi $VERSION"
echo "Work Area: $WORK_AREA"
echo "========================================================"
echo ""

# Bersihkan temporary build folder
rm -rf "$TMP"
