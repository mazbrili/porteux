#!/bin/bash

# Memuat utility pengunduh dan splitter
source "$BUILDERUTILSPATH/latestfromgithub.sh"
source "$BUILDERUTILSPATH/gobo_splitter.sh"

PRGNAM=Zstd
CWD=$(dirname "$0")
TMP="$MODULEPATH/$PRGNAM"
DEST="$TMP/package-$PRGNAM"

set -e

# Bersihkan dan siapkan folder kerja
[ -e "$TMP" ] && rm -rf "$TMP"
mkdir -p "$TMP"
cd "$TMP"

# 1. FETCH VERSION & SOURCE
# Mengambil dari Facebook Zstd
info=$(DownloadLatestFromGithub "facebook" "zstd")
VERSION=${info#* }

tar xf zstd-$VERSION.tar.?z
cd zstd-$VERSION

# 2. PATH DEFINITIONS
PKG_DIR="/Programs/$PRGNAM/$VERSION"

# 3. CONFIGURE (CMake)
# Masuk ke folder build khusus cmake
cd build/cmake

CC=clang \
CXX=clang++ \
LDFLAGS="$LLDFLAGS" \
cmake -B build -S . \
	-G Ninja \
	-DCMAKE_C_FLAGS="$CLANGFLAGS" \
	-DCMAKE_CXX_FLAGS="$CLANGFLAGS -fvisibility-inlines-hidden" \
	-DCMAKE_INSTALL_PREFIX="$PKG_DIR" \
	-DCMAKE_INSTALL_LIBDIR="Lib" \
	-DCMAKE_INSTALL_BINDIR="bin" \
	-DCMAKE_INSTALL_INCLUDEDIR="include" \
	-DCMAKE_INSTALL_DATAROOTDIR="Shared" \
	-DBUILD_SHARED_LIBS=ON \
	-DZSTD_BUILD_STATIC=OFF \
	-DZSTD_PROGRAMS_LINK_SHARED=ON \
	-DZSTD_LZ4_SUPPORT=ON \
	-DZSTD_LZMA_SUPPORT=ON \
	-DZSTD_ZLIB_SUPPORT=ON

# 4. BUILD & INSTALL
DESTDIR="$DEST" ninja -C build install

# 5. GOBOLINUX ADJUSTMENTS
# Zstd terkadang menginstal file dokumentasi tambahan di Shared/doc
rm -rf "$DEST$PKG_DIR/Shared/doc"

# 6. CALL GENERIC SPLITTER
# Memindahkan zstd.h, libzstd.pc, dsb ke 05-devel
GoboSplitter "$PRGNAM" "$VERSION" "$DEST"

# 7. CLEANUP
rm -rf "$TMP"

echo "========================================================"
echo "Build $PRGNAM-$VERSION selesai."
echo "Fitur: LZ4, LZMA, ZLIB support enabled."
echo "========================================================"
