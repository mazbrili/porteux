#!/bin/bash

source "$BUILDERUTILSPATH/latestfromgithub.sh"

PRGNAM=LibXcrypt
CWD=$(dirname "$0")
# Folder temporary build agar tidak mengganggu sistem host
TMP="$MODULEPATH/$PRGNAM"

set -e

[ -e "$TMP" ] && rm -rf "$TMP"
mkdir -p "$TMP"
cd "$TMP"

# Ambil versi terbaru dari GitHub besser82
info=$(DownloadLatestFromGithub "besser82" "libxcrypt")
VERSION=${info#* }

# Path standar GoboLinux 17
PKG_DIR="/Programs/$PRGNAM/$VERSION"
DEST="$TMP/package-$PRGNAM"
WORK_AREA="$MODULEPATH/work_area/$PRGNAM"

tar xf libxcrypt-$VERSION.tar.?z
cd libxcrypt-$VERSION

# Konfigurasi dengan standar GoboLinux
# Kita matikan obsolete-api karena GoboLinux 17 fokus pada standar modern
CFLAGS="$GCCFLAGS -Wno-error=discarded-qualifiers" \
./configure \
	--prefix="$PKG_DIR" \
	--libdir="$PKG_DIR/Lib" \
	--includedir="$PKG_DIR/include" \
	--disable-static \
	--enable-hashes=strong,glibc \
	--enable-obsolete-api=no \
	--disable-failure-tokens \
	--build="$ARCH-gobolinux-linux"

make -j$NUMBERTHREADS install DESTDIR="$DEST"

# --- TAHAP INTEGRASI GOBO ---

# 1. Pembersihan file .la dan dokumentasi
find "$DEST" -type f -name "*.la" -delete
rm -rf "$DEST$PKG_DIR/Shared/man"

# 2. Penanganan Library
# Di GoboLinux, kita ingin library utama tetap berada di dalam folder Program,
# namun kita perlu memastikan symlink internal benar.
cd "$DEST$PKG_DIR/Lib"

# Pastikan symlink libcrypt.so dan libxcrypt.so menunjuk ke soname yang tepat di folder yang sama
# Ini penting agar saat kompilasi paket lain (seperti Shadow atau PAM), mereka menemukan lib ini.
ln -sf libcrypt.so.2 libcrypt.so
ln -sf libcrypt.so.2 libxcrypt.so

# 3. Integrasi ke Work Area
rm -rf "$WORK_AREA"
mkdir -p "$WORK_AREA"
cp -a "$DEST"/* "$WORK_AREA/"

echo ""
echo "========================================================"
echo "Selesai: $PRGNAM versi $VERSION"
echo "Lokasi: $WORK_AREA"
echo "========================================================"
echo ""

# Bersihkan sisa kompilasi
rm -rf "$TMP"
