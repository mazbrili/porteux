#!/bin/bash

PRGNAM=Glibc
CWD=$(dirname "$0")
TMP="$MODULEPATH/$PRGNAM"

set -e

[ -e "$TMP" ] && rm -rf "$TMP"
mkdir -p "$TMP"
cd "$TMP"

# Mengambil versi terbaru dari GNU FTP
VERSION=$(curl -s https://ftp.gnu.org/gnu/glibc/ | grep "glibc-[0-9]" | grep ".tar.xz" | grep -Ev "sig" | cut -d "=" -f 5 | cut -d "\"" -f 2 | sort -Vr | head -1 | cut -d "-" -f 2 | rev | cut -d "." -f 3- | rev)
wget "https://ftp.gnu.org/gnu/glibc/glibc-${VERSION}.tar.xz"

tar xf glibc-$VERSION.tar.xz
cd glibc-$VERSION

# Persiapan Path Gobo
PKG_DIR="/Programs/$PRGNAM/$VERSION"
DEST="$TMP/package-$PRGNAM"
WORK_AREA="$MODULEPATH/work_area/$PRGNAM"

# Terapkan Patch Porteux
cp -f "$CWD/SUPPORTED" localedata
patch -p1 < "$CWD/glibc.locale.no-archive.patch"
patch -p1 < "$CWD/glibc-2.32.en_US.no.am.pm.date.format.patch"
[[ "$ARCHITECTURELEVEL" == "x86-64-v3" ]] || [[ "$ARCHITECTURELEVEL" == "x86-64-v4" ]] && patch -p0 < "$CWD/improve-performance-avx2.patch"

mkdir build && cd build

# Hapus flag yang bisa merusak build glibc
LDFLAGS="${LDFLAGS/-Wl,--gc-sections/}"

# Konfigurasi khusus GoboLinux
# --with-headers diarahkan ke System Index karena headers kernel ada di sana
CFLAGS="${GCCFLAGS/-flto=auto/} -fPIC" \
CXXFLAGS="${GCCFLAGS} -fvisibility-inlines-hidden -fPIC" \
../configure \
	--prefix="$PKG_DIR" \
	--libdir="$PKG_DIR/Lib" \
	--includedir="$PKG_DIR/include" \
	--sysconfdir="/System/Settings" \
	--enable-kernel=6.1 \
	--with-headers="/System/Index/include" \
	--with-tls \
	--with-__thread \
	--without-cvs \
	--disable-nscd \
	--disable-profile \
	--disable-werror \
	--build="$ARCH-gobolinux-linux"

make -j$NUMBERTHREADS
make -j$NUMBERTHREADS install install_root="$DEST"

# Instalasi locale minimal (hanya en_US sesuai skrip asli)
make -j$NUMBERTHREADS localedata/install-locales install_root="$DEST"

# --- TAHAP INTEGRASI LIBXCRYPT ---
# Jalankan libxcrypt yang sudah kita modifikasi sebelumnya
pushd "$CWD"
MODULEPATH="$MODULEPATH" PKG="$DEST" sh libxcrypt.build
popd

# --- PENYESUAIAN STRUKTUR GOBOLINUX ---

# 1. Pindahkan binari ke folder bin di dalam Program
mkdir -p "$DEST$PKG_DIR/bin"
# Di Gobo, sbin biasanya digabung ke bin untuk kemudahan
if [ -d "$DEST$PKG_DIR/sbin" ]; then
    mv "$DEST$PKG_DIR/sbin"/* "$DEST$PKG_DIR/bin/"
    rmdir "$DEST$PKG_DIR/sbin"
fi

# 2. Perbaikan Dynamic Linker
# Sangat penting: Sistem membutuhkan ld-linux.so di path standar agar biner ELF bisa jalan.
# Kita akan membuat symlink di dalam /Programs yang nanti akan di-link ke /lib64.
mkdir -p "$DEST/System/Index/Lib"
cd "$DEST$PKG_DIR/Lib"
for linker in ld-linux*; do
    [ -f "$linker" ] && ln -sf "$PKG_DIR/Lib/$linker" "$DEST/System/Index/Lib/$linker"
done

# 3. Pembersihan (Cleaning)
rm -f "$DEST/System/Settings/ld.so.cache"
rm -rf "$DEST$PKG_DIR/Shared/i18n/charmaps"
rm -rf "$DEST$PKG_DIR/Shared/locale"
# Sisakan hanya locale minimal
find "$DEST$PKG_DIR/Shared/i18n/locales" -mindepth 1 -maxdepth 1 ! \( -name "en_US" -o -name "POSIX" \) -delete

# 4. Integrasi ke Work Area
rm -rf "$WORK_AREA"
mkdir -p "$WORK_AREA"
cp -a "$DEST"/* "$WORK_AREA/"

echo "========================================================"
echo "Glibc $VERSION Berhasil Dibangun untuk GoboLinux"
echo "Work Area: $WORK_AREA"
echo "========================================================"

rm -rf "$TMP"
