#!/bin/bash

# Load helpers
source "$BUILDERUTILSPATH/latestfromgithub.sh"
source "$BUILDERUTILSPATH/gobo_splitter.sh"

PRGNAM=Procps-NG
PRGNAMDOWNLOAD=procps
CWD=$(dirname "$0")
TMP="$MODULEPATH/$PRGNAM"
DEST="$TMP/package-$PRGNAM"

set -e

[ -e "$TMP" ] && rm -rf "$TMP"
mkdir -p "$TMP"
cd "$TMP"

# 1. FETCH VERSIONS & SOURCES
# Procps-NG
downloadedVersion=$(curl -s https://gitlab.com/${PRGNAMDOWNLOAD}/${PRGNAMDOWNLOAD}/-/tags?format=atom | grep -oPm 20 '(?<= <title>)[^<]+' | grep -v rc | sort -Vr | head -1)
VERSION=${downloadedVersion//[vV]}
wget "https://gitlab.com/${PRGNAMDOWNLOAD}/${PRGNAMDOWNLOAD}/-/archive/${downloadedVersion}/${PRGNAMDOWNLOAD}-${downloadedVersion}.tar.gz"

# Psmisc
PSMISCVER=$(curl -s https://gitlab.com/psmisc/psmisc/-/tags?format=atom | grep -oPm 20 '(?<= <title>)[^<]+' | grep -v rc | sort -Vr | head -1)
wget "https://gitlab.com/psmisc/psmisc/-/archive/${PSMISCVER}/psmisc-${PSMISCVER}.tar.gz"

# Procinfo-NG (Local source)
PROCINFONGVER=${PROCINFONGVER:-2.0.304}

tar xf $PRGNAMDOWNLOAD-${downloadedVersion}.tar.?z
tar xf psmisc-$PSMISCVER.tar.?z
tar xf "$CWD/procinfo-ng-$PROCINFONGVER.tar.?z"

# 2. PATH DEFINITIONS
PKG_DIR="/Programs/$PRGNAM/$VERSION"

# 3. BUILD PROCPS-NG
cd "$TMP/$PRGNAMDOWNLOAD-${downloadedVersion}"
# Fix ncurses header path for GoboLinux compatibility
sed 's:<ncursesw/:<:g' -i src/watch.c
echo $VERSION > .version
echo $VERSION > .tarball-version

CFLAGS="$GCCFLAGS" \
./autogen.sh && ./configure \
	--prefix="$PKG_DIR" \
	--bindir="$PKG_DIR/bin" \
	--sbindir="$PKG_DIR/bin" \
	--libdir="$PKG_DIR/Lib" \
	--includedir="$PKG_DIR/include" \
	--sysconfdir="/System/Settings" \
	--localstatedir="/System/Variable" \
	--datarootdir="$PKG_DIR/Shared" \
	--enable-static=no \
	--disable-silent-rules \
	--disable-rpath \
	--enable-watch8bit \
	--enable-skill \
	--enable-sigwinch \
	--enable-w-from \
	--disable-kill \
	--without-systemd \
	--with-elogind \
	--disable-modern-top \
	--build="$ARCH-gobolinux-linux"

make -j${NUMBERTHREADS} install DESTDIR="$DEST"

# 4. BUILD PSMISC
cd "$TMP/psmisc-$PSMISCVER"
CFLAGS="$GCCFLAGS" \
./autogen.sh && ./configure \
	--prefix="$PKG_DIR" \
	--bindir="$PKG_DIR/bin" \
	--libdir="$PKG_DIR/Lib" \
	--sysconfdir="/System/Settings" \
	--localstatedir="/System/Variable" \
	--datarootdir="$PKG_DIR/Shared" \
	--disable-silent-rules \
	--disable-rpath \
	--build="$ARCH-gobolinux-linux"

make -j${NUMBERTHREADS} install DESTDIR="$DEST"

# 5. BUILD PROCINFO-NG
cd "$TMP/procinfo-ng-$PROCINFONGVER"
CXXFLAGS="$GCCFLAGS -fvisibility-inlines-hidden" \
./configure \
	--prefix="$PKG_DIR" \
	--bindir="$PKG_DIR/bin" \
	--libdir="$PKG_DIR/Lib" \
	--sysconfdir="/System/Settings" \
	--localstatedir="/System/Variable" \
	--datarootdir="$PKG_DIR/Shared" \
	--enable-maintainer-mode \
	--build="$ARCH-gobolinux-linux"

make -j${NUMBERTHREADS} install DESTDIR="$DEST"

# 6. GOBOLINUX ADJUSTMENTS
cd "$DEST$PKG_DIR"

# Gabungkan sbin ke bin jika ada yang mendarat di sana
if [ -d sbin ]; then
    mv sbin/* bin/ 2>/dev/null || true
    rmdir sbin
fi

# Pembersihan metadata/dokumentasi
find "$DEST" -type f -name "*.la" -delete
rm -rf Shared/doc Shared/man Shared/locale

# 7. CALL GENERIC SPLITTER
# Ini akan memisahkan libproc-2.so headers dan pkgconfig ke 05-devel
GoboSplitter "$PRGNAM" "$VERSION" "$DEST"

# 8. CLEANUP
rm -rf "$TMP"

echo "========================================================"
echo "$PRGNAM Suite (procps, psmisc, procinfo) Selesai"
echo "Status: Split ke 001-core dan 05-devel"
echo "========================================================"
