#!/bin/bash

# Memuat utility pengunduh terbaru
source "$BUILDERUTILSPATH/latestfromgithub.sh"

PRGNAM=Squashfs-Tools
CWD=$(dirname "$0")
# Folder temporary build
TMP="$MODULEPATH/$PRGNAM"

set -e

# Bersihkan folder kerja
[ -e "$TMP" ] && rm -rf "$TMP"
mkdir -p "$TMP"
cd "$TMP"

# Ambil versi terbaru dari GitHub plougher
info=$(DownloadLatestFromGithub "plougher" "squashfs-tools" "squashfs-tools|CVE")
VERSION=${info#* }

# Path standar GoboLinux
PKG_DIR="/Programs/$PRGNAM/$VERSION"
DEST="$TMP/package-$PRGNAM"
WORK_AREA="$MODULEPATH/work_area/$PRGNAM"

# Ekstraksi source
# Squashfs-tools sering kali menggunakan ekstrak ganda atau folder bersarang
tar xf squashfs-tools-$VERSION.tar.?z*
cd squashfs-tools-$VERSION

# Masuk ke direktori source utama
cd squashfs-tools

# Kompilasi dengan dukungan kompresi lengkap (Zstd sebagai default sesuai gaya Porteus)
# GoboLinux menggunakan GCCFLAGS yang sudah didefinisikan di setflags.sh
CFLAGS="$GCCFLAGS" \
make -j${NUMBERTHREADS} \
	GZIP_SUPPORT="1" \
	XZ_SUPPORT="1" \
	LZ4_SUPPORT="1" \
	LZO_SUPPORT="1" \
	LZMA_XZ_SUPPORT="1" \
	ZSTD_SUPPORT="1" \
	COMP_DEFAULT="zstd"

# Instalasi ke folder temporary DEST
# Kita arahkan binari ke folder bin di dalam struktur Programs
mkdir -p "$DEST$PKG_DIR/bin"
make install INSTALL_DIR="$DEST$PKG_DIR/bin"

# --- TAHAP INTEGRASI GOBO ---

# Hapus file .la jika ada (biasanya tidak ada di squashfs-tools, tapi untuk jaga-jaga)
find "$DEST" -type f -name "*.la" -delete

# Pastikan folder target di work_area bersih
rm -rf "$WORK_AREA"
mkdir -p "$WORK_AREA"

# Pindahkan hasil build ke work_area modul
# Struktur: $WORK_AREA/Programs/Squashfs-Tools/$VERSION/bin/mksquashfs, dll.
cp -a "$DEST"/* "$WORK_AREA/"

echo ""
echo "========================================================"
echo "Selesai: $PRGNAM versi $VERSION"
echo "Lokasi: $WORK_AREA"
echo "========================================================"
echo ""

# Bersihkan temporary build folder
rm -rf "$TMP"
