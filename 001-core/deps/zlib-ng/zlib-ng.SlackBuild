#!/bin/bash

# Memuat utility pengunduh dan splitter
source "$BUILDERUTILSPATH/latestfromgithub.sh"
source "$BUILDERUTILSPATH/gobo_splitter.sh"

PRGNAM=ZLib-NG
CWD=$(dirname "$0")
TMP="$MODULEPATH/$PRGNAM"
DEST="$TMP/package-$PRGNAM"

set -e

# Bersihkan folder kerja
[ -e "$TMP" ] && rm -rf "$TMP"
mkdir -p "$TMP"
cd "$TMP"

# 1. FETCH VERSION & SOURCE
info=$(DownloadLatestFromGithub "zlib-ng" "zlib-ng")
VERSION=${info#* }

tar xf zlib-ng-$VERSION.tar.?z
cd zlib-ng-$VERSION

# 2. PATH DEFINITIONS
PKG_DIR="/Programs/$PRGNAM/$VERSION"

# 3. CONFIGURE (CMake)
# ZLIB_COMPAT=ON sangat penting agar paket lain mengenalnya sebagai 'zlib'
cmake -B build -S . \
	-G Ninja \
	-DCMAKE_C_COMPILER=clang \
	-DCMAKE_C_FLAGS="$CLANGFLAGS" \
	-DCMAKE_EXE_LINKER_FLAGS="$LLDFLAGS" \
	-DCMAKE_INSTALL_PREFIX="$PKG_DIR" \
	-DCMAKE_INSTALL_LIBDIR="Lib" \
	-DCMAKE_INSTALL_BINDIR="bin" \
	-DCMAKE_INSTALL_INCLUDEDIR="include" \
	-DCMAKE_INSTALL_DATAROOTDIR="Shared" \
	-DZLIB_COMPAT=ON \
	-DWITH_GTEST=OFF \
	-DBUILD_TESTING=OFF

# 4. BUILD & INSTALL
DESTDIR="$DEST" ninja -C build install

# 5. GOBOLINUX ADJUSTMENTS
# Hapus file statis jika cmake tetap membuatnya (opsional, tapi splitter akan menanganinya)
find "$DEST" -type f -name "*.la" -delete

# 6. CALL GENERIC SPLITTER
# ZLib-NG menyediakan zlib.h dan zconf.h yang wajib ada di 05-devel
GoboSplitter "$PRGNAM" "$VERSION" "$DEST"

# 7. CLEANUP
rm -rf "$TMP"

echo "========================================================"
echo "Build $PRGNAM-$VERSION selesai."
echo "Mode: ZLib-Compat (Replacement for zlib)"
echo "========================================================"
