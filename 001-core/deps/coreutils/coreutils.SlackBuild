#!/bin/bash

PRGNAM=CoreUtils
# Versi dibersihkan untuk standar Gobo (misal: 9.4)
CWD=$(dirname "$0")

# Setup folder kerja sesuai variabel yang kita bahas sebelumnya
TMP="$MODULEPATH/$PRGNAM"
# Lokasi instalasi akhir sesuai hierarki GoboLinux
VERSION_FULL=$(curl -s https://ftp.gnu.org/gnu/${coreutils}/ | grep "coreutils-[0-9]" | grep ".tar.xz" | grep -v "sig" | sed -n 's/.*coreutils-\([0-9.]*\)\.tar\.xz.*/\1/p' | sort -Vr | head -1)
VERSION=${VERSION_FULL:-"9.4"} # Fallback jika curl gagal

# Path absolut untuk GoboLinux
PKG_DIR="/Programs/$PRGNAM/$VERSION"
DEST="$TMP/package-$PRGNAM"

set -e

[ -e "$TMP" ] && rm -rf "$TMP"
mkdir -p "$TMP" "$DEST"
cd "$TMP"

# Download Source (Tetap menggunakan GNU mirror sesuai request sebelumnya)
wget "https://ftp.gnu.org/gnu/coreutils/coreutils-${VERSION}.tar.xz"

tar xf coreutils-${VERSION}.tar.xz
cd coreutils-${VERSION}

# Terapkan patch (Pastikan file .patch ada di folder skrip)
[ -f "$CWD/fix-cpu-info.patch" ] && patch -p1 < "$CWD/fix-cpu-info.patch"
[ -f "$CWD/no-ls-quoting.patch" ] && patch -p1 < "$CWD/no-ls-quoting.patch"

# Konfigurasi ala GoboLinux
# Kita gunakan --prefix agar menunjuk ke folder program, bukan root sistem
FORCE_UNSAFE_CONFIGURE=1 \
CFLAGS="$GCCFLAGS -ffat-lto-objects" \
./configure \
  --prefix="$PKG_DIR" \
  --bindir="$PKG_DIR/bin" \
  --sbindir="$PKG_DIR/bin" \
  --libexecdir="$PKG_DIR/libexec" \
  --datarootdir="$PKG_DIR/Shared" \
  --enable-install-program=arch \
  --with-openssl=no \
  --enable-no-install-program=hostname,kill,uptime \
  --build="$ARCH-gobolinux-linux"

make $NUMJOBS
# Install ke folder temporary DESTDIR
make install DESTDIR="$DEST"

# Penyesuaian Hierarki Gobo di dalam DESTDIR
# 'make install' akan membuat struktur /Programs/CoreUtils/... di dalam $DEST
# Kita bersihkan file yang tidak perlu untuk modul ISO Porteus yang ringan
cd "$DEST$PKG_DIR"

rm -rf Shared/info
rm -rf Shared/man
rm -rf Shared/locale

# Opsional: Jika Anda ingin memisahkan devel files (headers)
# rm -rf include

# Finalisasi: Membungkus menjadi modul .xzm (Gaya Porteus)
# Di GoboLinux Porteus-style, kita membungkus seluruh folder /Programs
echo "Membungkus modul ${PRGNAM}..."
mkdir -p "$MODULEPATH/packages"

# Kita pindah ke root folder DEST agar mksquashfs mengambil struktur /Programs
cd "$DEST"
mksquashfs . "$MODULEPATH/packages/${PRGNAM}-${VERSION}-${ARCH}-Gobo.xzm" -comp zstd -b 256K -noappend

# Cleanup folder temporary build
rm -rf "$TMP"
