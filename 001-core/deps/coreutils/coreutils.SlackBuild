#!/bin/bash

# Load helpers
source "$BUILDERUTILSPATH/latestfromgithub.sh"
source "$BUILDERUTILSPATH/gobo_splitter.sh"

PRGNAM=CoreUtils
CWD=$(dirname "$0")
TMP="$MODULEPATH/$PRGNAM"

set -e

[ -e "$TMP" ] && rm -rf "$TMP"
mkdir -p "$TMP"
cd "$TMP"

# 1. FETCH VERSION & SOURCE
# Mengambil versi terbaru dari GNU FTP
VERSION=$(curl -s https://ftp.gnu.org/gnu/coreutils/ | grep "coreutils-[0-9]" | grep ".tar.xz" | grep -v "sig" | sed -n 's/.*coreutils-\([0-9.]*\)\.tar\.xz.*/\1/p' | sort -Vr | head -1)
VERSION=${VERSION:-"9.5"} # Default fallback

wget "https://ftp.gnu.org/gnu/coreutils/coreutils-${VERSION}.tar.xz"
tar xf coreutils-${VERSION}.tar.xz
cd coreutils-${VERSION}

# 2. PATH DEFINITIONS (Gobo Hierarchy)
PKG_DIR="/Programs/$PRGNAM/$VERSION"
DEST="$TMP/package-$PRGNAM"

# 3. PATCHING
[ -f "$CWD/fix-cpu-info.patch" ] && patch -p1 < "$CWD/fix-cpu-info.patch"
[ -f "$CWD/no-ls-quoting.patch" ] && patch -p1 < "$CWD/no-ls-quoting.patch"

# 4. CONFIGURE
# GoboLinux menggunakan --datarootdir="$PKG_DIR/Shared" untuk manual/data
FORCE_UNSAFE_CONFIGURE=1 \
CFLAGS="$GCCFLAGS -ffat-lto-objects" \
./configure \
  --prefix="$PKG_DIR" \
  --bindir="$PKG_DIR/bin" \
  --sbindir="$PKG_DIR/bin" \
  --libexecdir="$PKG_DIR/Libexec" \
  --datarootdir="$PKG_DIR/Shared" \
  --sysconfdir="/System/Settings" \
  --enable-install-program=arch \
  --with-openssl=no \
  --enable-no-install-program=hostname,kill,uptime \
  --build="$ARCH-gobolinux-linux"

# 5. BUILD & INSTALL
make -j$NUMBERTHREADS
make install DESTDIR="$DEST"

# 6. GOBOLINUX ADJUSTMENTS
# Membersihkan sampah sebelum splitter bekerja
rm -rf "$DEST$PKG_DIR/Shared/info"
rm -rf "$DEST$PKG_DIR/Shared/man"
rm -rf "$DEST$PKG_DIR/Shared/locale"

# 7. CALL GENERIC SPLITTER
# Ini akan memindahkan file devel (jika ada) ke work_area/05-devel
# dan file runtime ke work_area/001-core
GoboSplitter "$PRGNAM" "$VERSION" "$DEST"

# 8. CLEANUP
rm -rf "$TMP"

echo "========================================================"
echo "Build $PRGNAM-$VERSION selesai dan telah dipisahkan."
echo "========================================================"
