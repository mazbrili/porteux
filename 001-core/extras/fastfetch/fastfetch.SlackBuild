#!/bin/bash

# Load helpers
source "$BUILDERUTILSPATH/latestfromgithub.sh"
source "$BUILDERUTILSPATH/gobo_splitter.sh"

PRGNAM=Fastfetch
CWD=$(dirname "$0")
TMP="$MODULEPATH/$PRGNAM"
DEST="$TMP/package-$PRGNAM"

set -e

[ -e "$TMP" ] && rm -rf "$TMP"
mkdir -p "$TMP"
cd "$TMP"

# 1. FETCH VERSION & SOURCE
info=$(DownloadLatestFromGithub "fastfetch-cli" "fastfetch")
VERSION=${info#* }

tar xf fastfetch-${VERSION}.tar.gz
cd fastfetch-${VERSION}

# 2. PATH DEFINITIONS
PKG_DIR="/Programs/$PRGNAM/$VERSION"

# 3. CONFIGURE (CMake)
# Kita arahkan instalasi ke folder Program Gobo
cmake -B build -S . \
	-G Ninja \
	-DCMAKE_C_FLAGS="$GCCFLAGS" \
	-DCMAKE_CXX_FLAGS="$GCCFLAGS -fvisibility-inlines-hidden" \
	-DCMAKE_INSTALL_PREFIX="$PKG_DIR" \
	-DCMAKE_INSTALL_BINDIR="bin" \
	-DCMAKE_INSTALL_SYSCONFDIR="/System/Settings" \
	-DCMAKE_INSTALL_DATADIR="Shared" \
	-DBUILD_FLASHFETCH=no \
	-DENABLE_OPENCL=off

# 4. BUILD & INSTALL
DESTDIR="$DEST" ninja -C build install -j${NUMBERTHREADS}

# 5. GOBOLINUX ADJUSTMENTS

# Membuat wrapper/alias neofetch agar tetap bisa dipanggil
# Perhatikan penggunaan path absolut Gobo di dalam script wrapper
mkdir -p "$DEST$PKG_DIR/bin"
cat <<EOF > "$DEST$PKG_DIR/bin/neofetch"
#!/bin/sh
$PKG_DIR/bin/fastfetch --logo linux --color-title blue --color-keys blue -s Title:Separator:OS:Host:Kernel:Uptime:Packages:Shell:Display:DE:WM:WMTheme:Theme:Icons:Font:Cursor:Terminal:TerminalFont:CPU:GPU:Memory:Swap:LocalIp:Battery:PowerAdapter:Locale:Break:Colors "\$@"
EOF
chmod 755 "$DEST$PKG_DIR/bin/neofetch"

# Pembersihan dokumentasi/share bawaan CMake yang tidak diperlukan di 001-core
rm -rf "$DEST$PKG_DIR/Shared"

# 6. CALL GENERIC SPLITTER
# Fastfetch biasanya mandiri, tapi jika ada library/header akan dipisah otomatis
GoboSplitter "$PRGNAM" "$VERSION" "$DEST"

# 7. CLEANUP
rm -rf "$TMP"

echo "========================================================"
echo "Build $PRGNAM-$VERSION selesai."
echo "Alias 'neofetch' telah ditambahkan ke $PKG_DIR/bin"
echo "========================================================"
